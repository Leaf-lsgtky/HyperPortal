<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".HyperPortalApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="HyperPortal"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <provider
            android:name=".PortalFileProvider"
            android:authorities="com.github.leaf.hyperportal.files"
            android:exported="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BlacklistActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TargetSettingsActivity"
            android:exported="false" />

        <!--
          BigBang text segmentation. Exported because the LSPosed SystemUI module
          runs under com.android.systemui's UID and must be able to launch it.
          It only displays caller-supplied text.
        -->
        <activity
            android:name=".bigbang.TextSegmentationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.github.leaf.hyperportal.overlay"
            android:label="@string/bigbang_overlay_title"
            android:theme="@style/Theme.HyperPortal.BigBangOverlay" />

        <!--
          Development aid: asks libxposed (API 102) to hot-reload this module into
          the running system_server / SystemUI, so a rebuilt module can be
          verified without rebooting. Only adb shell / root / system may trigger.
        -->
        <receiver
            android:name=".HotReloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.github.leaf.hyperportal.HOT_RELOAD" />
            </intent-filter>
        </receiver>

        <!-- Transparent BAL trampoline for image shares launched from SystemUI. -->
        <activity
            android:name=".ShareProxyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.github.leaf.hyperportal.overlay"
            android:theme="@style/Theme.HyperPortal.ShareProxy" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="HyperPortal: ColorOS 15 Fluid Cloud &amp; Content DragShare for HyperOS" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
    </application>
</manifest>
